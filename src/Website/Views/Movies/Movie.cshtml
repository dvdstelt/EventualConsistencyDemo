@using System.Web
@using System.Globalization
@using Shared.Entities
@model MovieViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    var m = Model.Movie;
    ViewData["Title"] = m.Title;
    ViewBag.Nav = "movies";
    Layout = "_LayoutFront";

    var isRaffle = m.TicketType == TicketType.DrawingTicket;
    // Specials & Events (not the raffle) get a single made-up showing.
    var isSpecial = !isRaffle && m.Category != MovieCategory.NowShowing;
    var age = m.Icons.FirstOrDefault(i => i.All(char.IsDigit));
    var logoRel = $"img/logos/{m.UrlTitle}.png";
    var heroLogo = System.IO.File.Exists(System.IO.Path.Combine(Env.WebRootPath, logoRel)) ? "/" + logoRel : null;

    // Runtime (minutes) parsed from "80 minutes | ..." to derive end times.
    var runtime = 120;
    var firstNum = new string((m.MovieDetails ?? "").TakeWhile(char.IsDigit).ToArray());
    if (int.TryParse(firstNum, out var parsed)) { runtime = parsed; }

    string EndTime(string start) =>
        TimeSpan.TryParse(start, out var t) ? t.Add(TimeSpan.FromMinutes(runtime)).ToString(@"hh\:mm") : "";
}

@functions {
    static readonly string[] TimePool =
        { "10:15", "11:30", "13:00", "14:15", "15:45", "17:00", "18:30", "20:00", "21:15", "22:30", "23:15" };

    // A deterministic set of showtimes for a (movie, day): each day differs, but
    // nothing reshuffles while the demo runs since it's seeded, not random.
    static List<string> ShowtimesForDay(Guid movieId, int day)
    {
        uint seed = (uint)(day + 1) * 2654435761u;
        foreach (var b in movieId.ToByteArray()) { seed = seed * 31u + b; }
        uint Next() { seed = seed * 1664525u + 1013904223u; return seed; }

        var count = 3 + (int)(Next() % 3u);
        var picks = new SortedSet<int>();
        while (picks.Count < count) { picks.Add((int)(Next() % (uint)TimePool.Length)); }
        return picks.Select(i => TimePool[i]).ToList();
    }
}

@section Scripts {
    @if (isRaffle)
    {
        <script src="~/js/film-raffle.js" asp-append-version="true"></script>
    }
    else
    {
        <script src="~/js/film-booking.js" asp-append-version="true"></script>
    }
    @if (!string.IsNullOrWhiteSpace(m.Trailer))
    {
        <script src="~/js/trailer.js" asp-append-version="true"></script>
    }
    <script src="~/js/reviews.js" asp-append-version="true"></script>
}

<section class="film-hero">
    <div class="film-hero-media" style="background-image:url('/img/background/@m.Background')"></div>
    @if (!string.IsNullOrWhiteSpace(m.Trailer))
    {
        <button type="button" class="fh-play" data-trailer="@m.Trailer" aria-label="Play trailer">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
        </button>
    }
    <div class="wrap">
        <div class="fh-content">
            @if (heroLogo is not null)
            {
                <img class="hero-logo" src="@heroLogo" alt="@m.Title" style="margin-bottom:18px;" />
            }
            else
            {
                <h1 class="font-trade">@m.Title</h1>
            }
            <div class="fh-meta">
                <partial name="_AgeIcon" model="age" />
                <span>@m.MovieDetails</span>
            </div>
            <p class="fh-line"><strong>Release date:</strong> @m.ReleaseDate.ToString("d MMM yyyy", CultureInfo.InvariantCulture)</p>
            <p class="fh-synopsis">@Html.Raw(HttpUtility.HtmlDecode(m.Description))</p>
            <partial name="_Formats" />
            <div class="fh-actions" style="margin-top:20px;">
                <a class="btn btn-yellow btn-lg" href="#booking">🎟️ @(isRaffle ? "Enter the raffle" : "Order tickets")</a>
                <button type="button" class="fh-btn" data-reviews>Reviews</button>
            </div>
        </div>
    </div>
</section>

<section class="booking" id="booking"
         data-movie-id="@m.Id"
         data-movie-title="@m.Title"
         data-price="@m.PricePerTicket.ToString(CultureInfo.InvariantCulture)">
    <div class="wrap">
        @if (isRaffle)
        {
            var theater = Model.Theaters.First();
            var showtime = m.Showtimes.FirstOrDefault() ?? "20:00";
            <h2 class="font-trade">Sign up for the raffle</h2>
            <p class="sub">This one-off screening has a single date and showing. Because of the limited capacity you don't buy a ticket here, you enter the raffle instead.</p>

            <div class="raffle-login">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="3.4"/><path d="M5.5 20a6.5 6.5 0 0 1 13 0"/></svg>
                <span>Signed in as <strong>Demo User</strong> &middot; Club Popcorn 100428</span>
            </div>

            <div class="cinema-block" data-theater-id="@theater.Id">
                <div class="head">
                    <h3>@theater.Name</h3>
                    <span class="dist">Special evening screening</span>
                </div>
                <div class="version-label">Original version</div>
                <div class="st-grid">
                    <button class="st st-raffle" data-time="@showtime"><span class="st-time">@showtime</span><span class="st-end">&rarr; @EndTime(showtime)</span></button>
                </div>
            </div>

            <p class="raffle-note">Limited capacity &mdash; tickets are drawn among all entries. Winners are notified automatically with their tickets.</p>
        }
        else if (isSpecial)
        {
            // A single made-up showing: one date, one time.
            var showDate = DateTime.Today.AddDays(3 + m.Id.ToByteArray().Sum(b => (int)b) % 18);
            var showtime = m.Showtimes.FirstOrDefault() ?? "20:00";

            <h2 class="font-trade">Get tickets</h2>
            <p class="sub">A one-off special screening &mdash; one date, one showing.</p>

            <partial name="_CinemaSearch" model="Model.Theaters" />

            <div class="date-strip">
                <div class="date-pill active">
                    <div class="dow">@showDate.ToString("ddd", CultureInfo.InvariantCulture)</div>
                    <div class="day">@showDate.Day</div>
                    <div class="mon">@showDate.ToString("MMM", CultureInfo.InvariantCulture)</div>
                </div>
            </div>

            <div id="cinemaList">
                <p id="cinemaPrompt" class="sub">Choose a cinema above to see the showing.</p>
                @foreach (var theater in Model.Theaters)
                {
                    <div class="cinema-block" data-theater-id="@theater.Id" data-city="@theater.City" style="display:none;">
                        <div class="head">
                            <h3>@theater.Name</h3>
                        </div>
                        <div class="version-label">Special screening</div>
                        <div class="st-grid">
                            <button class="st" data-time="@showtime">
                                <span class="st-time">@showtime</span>
                                <span class="st-end">&rarr; @EndTime(showtime)</span>
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <h2 class="font-trade">Find showtimes</h2>
            <p class="sub">Pick a cinema and date to see the available showtimes.</p>

            ViewData["DefaultCinemaName"] = "Rotterdam - Schouwburgplein";
            <partial name="_CinemaSearch" model="Model.Theaters" />

            <div class="date-strip">
                @for (var d = 0; d < 7; d++)
                {
                    var day = DateTime.Today.AddDays(d);
                    <button type="button" class="date-pill @(d == 0 ? "active" : "")" data-day="@d">
                        <div class="dow">@day.ToString("ddd", CultureInfo.InvariantCulture)</div>
                        <div class="day">@day.Day</div>
                        <div class="mon">@day.ToString("MMM", CultureInfo.InvariantCulture)</div>
                    </button>
                }
            </div>

            <div id="cinemaList">
                <p id="cinemaPrompt" class="sub">Choose a cinema above to see the showtimes.</p>
                @foreach (var theater in Model.Theaters)
                {
                    <div class="cinema-block" data-theater-id="@theater.Id" data-city="@theater.City" style="display:none;">
                        <div class="head">
                            <h3>@theater.Name</h3>
                        </div>
                        <div class="version-label">Original version</div>
                        <div class="st-grid">
                            @for (var d = 0; d < 7; d++)
                            {
                                var times = ShowtimesForDay(m.Id, d);
                                for (var s = 0; s < times.Count; s++)
                                {
                                    var st = times[s];
                                    <button class="st" data-day="@d" data-time="@st" hidden="@(d != 0 ? "hidden" : null)">
                                        @if (s == 1)
                                        {
                                            <span class="st-badge">IMAX</span>
                                        }
                                        <span class="st-time">@st</span>
                                        <span class="st-end">&rarr; @EndTime(st)</span>
                                    </button>
                                }
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@if (isRaffle)
{
    <div id="raffle" class="flow-overlay" hidden>
        <div class="flow-card">
            <button class="flow-close" id="raffleClose" aria-label="Close" type="button">&times;</button>
            <div class="flow-steps">
                <span class="fstep active" data-step="1">1 &middot; Register</span>
                <span class="fstep" data-step="2">2 &middot; Confirmation</span>
            </div>

            <div class="flow-panel" data-panel="1">
                <h3>Enter the raffle</h3>
                <p class="flow-meta">@m.Title &middot; @Model.Theaters.First().Name</p>
                <div class="raffle-user">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="3.4"/><path d="M5.5 20a6.5 6.5 0 0 1 13 0"/></svg>
                    <div>
                        <strong>Demo User</strong>
                        <span>Club Popcorn 100428 &middot; your entry is linked to this account</span>
                    </div>
                </div>
                <ul class="raffle-rules">
                    <li>One entry per account</li>
                    <li>Winners are drawn after registration closes</li>
                    <li>Winners are notified automatically with their tickets</li>
                </ul>
                <div class="flow-foot">
                    <div class="summary">Free entry</div>
                    <button class="btn btn-yellow" id="raffleSubmit" type="button">Enter me in the raffle</button>
                </div>
            </div>

            <div class="flow-panel" data-panel="2" hidden>
                <div class="confirm">
                    <div class="check">&#10003;</div>
                    <h3>You're in the raffle!</h3>
                    <p>Your entry has been registered on your account. There's nothing else you need to do.</p>
                    <ul class="confirm-status" id="raffleStatus">
                        <li class="on">Entry received</li>
                        <li>Registered on your account</li>
                        <li>Confirmation sent</li>
                        <li>Draw notification scheduled</li>
                    </ul>
                    <div id="raffleDetails" class="order-result"></div>
                    <button class="btn btn-yellow" id="raffleDone" type="button">Close</button>
                </div>
            </div>
        </div>
    </div>

    <template id="lotteryticket">
        <table class="order-summary">
            <tr><td><strong>Movie</strong></td><td>{movieTitle}</td></tr>
            <tr><td><strong>Cinema</strong></td><td>{theater}</td></tr>
            <tr><td><strong>Time</strong></td><td>{time}</td></tr>
            <tr><td colspan="2">If you win, you'll be emailed your tickets on <strong>{drawingDate}</strong>.</td></tr>
        </table>
    </template>
}
else
{
    <div id="flow" class="flow-overlay" hidden>
        <div class="flow-card">
            <button class="flow-close" id="flowClose" aria-label="Close" type="button">&times;</button>
            <div class="flow-steps">
                <span class="fstep active" data-step="1">1 &middot; Seats</span>
                <span class="fstep" data-step="2">2 &middot; Payment</span>
                <span class="fstep" data-step="3">3 &middot; Confirmation</span>
            </div>

            <div class="flow-panel" data-panel="1">
                <h3>Choose your seats</h3>
                <p class="flow-meta" id="flowMeta"></p>
                <div class="seatmap" id="seatmap"></div>
                <div class="screen">SCREEN</div>
                <div class="seat-legend">
                    <span><svg class="seat-ico" viewBox="0 0 56 56"><use href="#seat-normal" xlink:href="#seat-normal"></use></svg> Available</span>
                    <span><svg class="seat-ico" viewBox="0 0 56 56"><use href="#seat-taken" xlink:href="#seat-taken"></use></svg> Taken</span>
                    <span><svg class="seat-ico" viewBox="0 0 56 56"><use href="#seat-selected" xlink:href="#seat-selected"></use></svg> Selected</span>
                </div>
                <div class="flow-foot">
                    <div class="summary"><strong id="seatCount">0</strong> seats &middot; &euro;<span id="seatTotal">0,00</span></div>
                    <button class="btn btn-yellow" id="toPay" disabled>Continue to payment</button>
                </div>
            </div>

            <div class="flow-panel" data-panel="2" hidden>
                <h3>Payment</h3>
                <p class="flow-meta">Your reservation is held for 10 minutes.</p>
                <div class="pay-methods">
                    <label class="pay"><input type="radio" name="pay" checked> iDEAL</label>
                    <label class="pay"><input type="radio" name="pay"> Credit card</label>
                    <label class="pay"><input type="radio" name="pay"> Popcorn Giftcard</label>
                </div>
                <div class="flow-foot">
                    <div class="summary">To pay: &euro;<span id="payTotal">0,00</span></div>
                    <button class="btn btn-yellow" id="doPay">Pay now</button>
                </div>
            </div>

            <div class="flow-panel" data-panel="3" hidden>
                <div class="confirm">
                    <div class="check">&#10003;</div>
                    <h3>Thanks! Your tickets are on their way</h3>
                    <p>We've received your order. Your e-tickets are sent by email once the payment is processed.</p>
                    <ul class="confirm-status" id="confirmStatus">
                        <li class="on">Payment received</li>
                        <li>Seats confirmed</li>
                        <li>E-tickets sent</li>
                        <li>Confirmation &amp; reminder scheduled</li>
                    </ul>
                    <div id="orderDetails" class="order-result"></div>
                    <button class="btn btn-yellow" id="flowDone">Close</button>
                </div>
            </div>
        </div>
    </div>

    <template id="regularticket">
        <table class="order-summary">
            <tr><td><strong>Movie</strong></td><td>{movieTitle}</td></tr>
            <tr><td><strong>Cinema</strong></td><td>{theater}</td></tr>
            <tr><td><strong>Time</strong></td><td>{time}</td></tr>
            <tr><td><strong>Tickets</strong></td><td>{numberOfTickets}</td></tr>
        </table>
    </template>
}

@if (!string.IsNullOrWhiteSpace(m.Trailer))
{
    <div id="trailerLightbox" class="lightbox" hidden>
        <button type="button" class="lightbox-close" id="trailerClose" aria-label="Close">&times;</button>
        <div class="lightbox-frame">
            <iframe id="trailerFrame" src="" title="@m.Title trailer" allow="autoplay; encrypted-media; fullscreen" allowfullscreen></iframe>
        </div>
    </div>
}

<div id="reviewsLightbox" class="lightbox" hidden>
    <div class="reviews-modal">
        <button type="button" class="flow-close" id="reviewsClose" aria-label="Close">&times;</button>
        <h3>Reviews &middot; @m.Title</h3>
        <ul class="review-list" id="reviewList">
            @foreach (var review in Model.Reviews)
            {
                <li>
                    <div class="review-avatar"><img src="https://gravatar.com/avatar/9300c92d4bbf31c4a96d345e9712d2a6.jpg?&s=50" alt="" /></div>
                    <div class="review-body">
                        <div class="review-text">@review.Description</div>
                        <div class="review-meta">@(review.PostedByEmail ?? "dvdstelt@gmail.com") | @review.ReviewedAt.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                </li>
            }
        </ul>
        <div class="reviews-form">
            <input type="hidden" id="reviewMovieId" value="@m.Id" />
            <label for="reviewText">Add your review</label>
            <textarea id="reviewText" rows="3" placeholder="What did you think?"></textarea>
            <div class="reviews-actions">
                <button type="button" class="btn btn-yellow" id="reviewSubmit">Submit review</button>
                <a href="#" id="reviewsClear" class="reviews-clear">Clear my reviews</a>
            </div>
        </div>
    </div>
</div>
