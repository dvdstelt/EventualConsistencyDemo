@model List<Shared.Entities.Movie>
@{
    ViewData["Title"] = "Movies";
    ViewBag.Nav = "movies";
    Layout = "_LayoutFront";
}

<section class="section" style="padding-top:96px;">
    <div class="wrap">
        <div class="section-head">
            <h2 class="font-trade">All movies</h2>
        </div>
        <div class="movie-grid">
            @foreach (var movie in Model.OrderByDescending(m => m.PopularityScore))
            {
                <partial name="_MovieCard" model="movie" />
            }
        </div>
    </div>
</section>
