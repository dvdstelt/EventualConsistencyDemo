@* Reusable cinema-format row (decorative). Icons come from _IconSprite.
   The outer <svg> repeats the symbol's viewBox so height:16px + width:auto keeps the aspect ratio. *@
<div class="formats">
    <span class="fmt fmt-logo" aria-label="4DX"><svg class="tech-logo tech-4dx" viewBox="0.35 0 41.74 15.65" aria-hidden="true"><use href="#fmt-4dx" xlink:href="#fmt-4dx"></use></svg></span>
    <span class="fmt fmt-logo" aria-label="IMAX"><svg class="tech-logo tech-imax" viewBox="0.35 0 45 8" aria-hidden="true"><use href="#fmt-imax" xlink:href="#fmt-imax"></use></svg></span>
    <span class="fmt fmt-logo" aria-label="Dolby Cinema"><svg class="tech-logo tech-dolby" viewBox="0 0 46 16" aria-hidden="true"><use href="#fmt-dolbycinema" xlink:href="#fmt-dolbycinema"></use></svg></span>
    <span class="fmt fmt-logo" aria-label="Dolby Atmos"><svg class="tech-logo tech-dolby" viewBox="0 0 46 16" aria-hidden="true"><use href="#fmt-dolbyatmos" xlink:href="#fmt-dolbyatmos"></use></svg></span>
</div>
