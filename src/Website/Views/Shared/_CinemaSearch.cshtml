@model List<Shared.Entities.Theater>
@* Cinema picker, identical on the homepage hero and the film page. Selecting a
   cinema filters the film page's showtimes to that cinema's city (see home.js).
   On pages without a showtime list it just records the selection.
   An optional ViewData["DefaultCinemaName"] pre-selects a cinema. *@
@{
    var defaultName = ViewData["DefaultCinemaName"] as string;
    var defaultTheater = defaultName is null ? null : Model.FirstOrDefault(t => t.Name == defaultName);
}
<div class="locbar">
    <span class="waar">Where?</span>
    <div class="cinema-select" id="cinemaSelect" data-default-city="@defaultTheater?.City">
        <button type="button" class="cs-trigger" aria-haspopup="listbox" aria-expanded="false">
            <span class="cs-value@(defaultTheater is null ? " cs-placeholder" : "")">@(defaultTheater?.Name ?? "Select a cinema")</span>
            <svg class="cs-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="cs-panel" hidden>
            <div class="cs-head">All cinemas (<span id="csCount">@Model.Count</span>)</div>
            <ul class="cs-list" role="listbox" aria-label="All cinemas">
                @foreach (var t in Model)
                {
                    <li class="cs-option" role="option" data-value="@t.Name" data-city="@t.City">
                        <span class="cs-name">@t.CinemaName</span>
                        @if (t.City != t.CinemaName)
                        {
                            <span class="cs-city">@t.City</span>
                        }
                    </li>
                }
            </ul>
        </div>
    </div>
    <a class="pill" href="#">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
        <span class="t">Near me</span>
    </a>
    <a class="pill" href="#">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20s-7-4.5-9.3-9C1.2 8.3 2.5 5 5.7 5c2 0 3.3 1.3 4.3 2.5C11 6.3 12.3 5 14.3 5 17.5 5 18.8 8.3 21.3 11c-2.3 4.5-9.3 9-9.3 9z"/></svg>
        <span class="t">Favourite cinemas</span>
    </a>
</div>
