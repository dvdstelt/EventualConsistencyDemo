@model List<Shared.Entities.Movie>
@{
    ViewData["Title"] = "Home";
    ViewBag.Nav = "home";
    Layout = "_LayoutFront";

    var byPopularity = Model.OrderByDescending(m => m.PopularityScore).ToList();
    var hero = byPopularity.FirstOrDefault();
}

@if (hero is not null)
{
    <section class="hero" style="background-image:url('/img/background/@hero.Background')">
        <div class="wrap">
            <h1 class="hero-title font-trade">@hero.Title</h1>
            <div class="cta-row">
                <a class="btn btn-yellow btn-lg" href="/movies/@Uri.EscapeDataString(hero.UrlTitle)">🎟️ Buy your tickets</a>
            </div>
        </div>
    </section>
}

<section class="section">
    <div class="wrap">
        <div class="section-head">
            <h2>Now showing</h2>
            <a class="more" asp-controller="Movies" asp-action="Index">All movies &rsaquo;</a>
        </div>
        <div class="carousel">
            @foreach (var movie in byPopularity)
            {
                <a class="movie-card" href="/movies/@Uri.EscapeDataString(movie.UrlTitle)">
                    <div class="poster">
                        @if (movie.TicketType == Shared.Entities.TicketType.DrawingTicket)
                        {
                            <span class="badge-corner koop">Raffle</span>
                        }
                        <img src="/img/posters/@movie.Image" alt="@movie.Title" />
                    </div>
                    <div class="card-info">
                        @{
                            var age = movie.Icons.FirstOrDefault(i => i.All(char.IsDigit));
                        }
                        @if (age is not null)
                        {
                            <span class="age-icon" title="@age+">@age</span>
                        }
                        <span class="title">@movie.Title</span>
                    </div>
                </a>
            }
        </div>
    </div>
</section>
